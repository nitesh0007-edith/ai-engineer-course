---
import '../styles/theme.css';

// Preload the fonts that paint above the fold (body serif, display, mono) so
// they arrive before first paint — otherwise the swap-in reflows the whole page
// and spikes CLS (DESIGN §3.1 sets a preload policy for exactly this reason).
import serif400 from '@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-400-normal.woff2?url';
import display600 from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-600-normal.woff2?url';
import mono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

const preloadFonts = [serif400, display600, mono400];

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'AI Engineer: Zero to Hero' } = Astro.props;

// BASE_URL may or may not carry a trailing slash depending on config; join safely
// so the favicon resolves under the project-page base in production.
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <title>{title}</title>
    {/* Resolve theme before first paint to avoid a flash. Runs blocking, tiny. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
