---
import Base from '../layouts/Base.astro';
import TopBar from '../components/ui/TopBar.astro';
import Figure from '../components/mdx/Figure.astro';
import CourseAssembly from '../components/diagrams/CourseAssembly.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="AI Engineer: Zero to Hero">
  <div class="app">
    <TopBar />
    <main class="canvas dot-canvas landing">
      <div class="hero">
        <p class="kicker">A FREE, INTERACTIVE COURSE</p>
        <h1>AI Engineer: Zero to Hero</h1>
        <p class="lede">
          The complete path from zero to production AI engineer — built to be
          <em>run</em>, not just read. Real Python in your browser, real models,
          real trade-offs. Eleven layers, from the maths up.
        </p>
        <a class="start" href={`${base}/chapters/how-to-use-this-course/`}>
          Start with “How to use this course” →
        </a>
      </div>

      <Figure
        id="00.0"
        label="THE COURSE, EXPLODED"
        caption="— the eleven layers you will work through, lower layers load-bearing for everything above."
      >
        <CourseAssembly />
      </Figure>
    </main>
  </div>
</Base>

<style>
  .landing {
    max-width: 820px;
    margin-inline: auto;
  }
  .hero {
    max-width: var(--measure);
    margin: 24px auto 8px;
  }
  .hero .kicker {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--blueprint);
    margin: 0 0 14px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 7vw, 54px);
    line-height: 1.05;
    margin: 0;
    color: var(--ink);
  }
  .hero .lede {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 18px 0 24px;
  }
  .start {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--paper-raise);
    background: var(--blueprint);
    border: 1px solid var(--blueprint);
    border-radius: 4px;
    padding: 12px 18px;
    text-decoration: none;
  }
</style>
