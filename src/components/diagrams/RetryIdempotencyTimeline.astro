---
/**
 * RetryIdempotencyTimeline — the bug an idempotency key exists to prevent.
 * Top: a client retries a timed-out POST with no idempotency key. The first
 * attempt actually succeeded server-side before the client gave up waiting —
 * the retry has no way to signal "this is the same request," so the server
 * processes it again. Two charges for one purchase. Bottom: the same timeline,
 * but the retry carries the same idempotency key as the first attempt. The
 * server recognizes the key, skips reprocessing, and returns the cached first
 * result instantly. One charge.
 */
---

<svg
  class="diagram-svg"
  viewBox="0 0 720 320"
  role="img"
  aria-label="Top panel: a client sends POST /charge, times out client-side at 2 seconds and gives up, but the server actually finished the charge at 1.8 seconds. The client retries with a new request; the server has no way to know it is a repeat, so it charges the card again — two charges for one purchase. Bottom panel: the same sequence, but both the original request and the retry carry the same idempotency key. The server recognizes the key on the retry and returns the already-computed result instantly instead of charging again — one charge total."
>
  <!-- ── TOP: no idempotency key ─────────────────────────────────── -->
  <text x="16" y="24" font-family="var(--font-mono)" font-size="11" letter-spacing="0.04em" fill="var(--ch2)">RETRY · no idempotency key</text>

  <line x1="150" y1="40" x2="150" y2="120" stroke="var(--hairline)" stroke-width="1" aria-hidden="true" />
  <text x="150" y="36" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">t=0</text>

  <rect x="150" y="48" width="332" height="24" rx="2" fill="var(--paper)" stroke="var(--ch2)" stroke-width="1.2" stroke-dasharray="4 3" />
  <text x="316" y="64" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ch2)">POST /charge — client waits, then times out</text>

  <line x1="404" y1="72" x2="404" y2="92" stroke="var(--ink-muted)" stroke-width="1" stroke-dasharray="2 2" aria-hidden="true" />
  <text x="404" y="104" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">server finishes the charge at t=1.8s —</text>
  <text x="404" y="116" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">client never sees the reply</text>

  <line x1="482" y1="40" x2="482" y2="72" stroke="var(--hairline)" stroke-width="1" aria-hidden="true" />
  <text x="482" y="36" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">t=2.0 client gives up</text>

  <rect x="532" y="48" width="150" height="24" rx="2" fill="var(--paper-raise)" stroke="var(--ch2)" stroke-width="1.3" />
  <text x="607" y="64" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ch2)">retry — new charge</text>

  <text x="682" y="40" text-anchor="end" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">t=2.3</text>

  <rect x="576" y="90" width="106" height="26" rx="3" fill="var(--paper)" stroke="var(--ch2)" stroke-width="1.3" />
  <text x="629" y="107" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--ch2)">2 charges</text>

  <!-- divider -->
  <line x1="16" y1="160" x2="704" y2="160" stroke="var(--hairline)" stroke-width="1" aria-hidden="true" />

  <!-- ── BOTTOM: with idempotency key ────────────────────────────── -->
  <text x="16" y="184" font-family="var(--font-mono)" font-size="11" letter-spacing="0.04em" fill="var(--ch1)">RETRY · same Idempotency-Key: abc123</text>

  <line x1="150" y1="200" x2="150" y2="280" stroke="var(--hairline)" stroke-width="1" aria-hidden="true" />
  <text x="150" y="196" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">t=0</text>

  <rect x="150" y="208" width="332" height="24" rx="2" fill="var(--paper)" stroke="var(--ch1)" stroke-width="1.2" stroke-dasharray="4 3" />
  <text x="316" y="224" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ch1)">POST /charge (key: abc123) — times out</text>

  <line x1="404" y1="232" x2="404" y2="252" stroke="var(--ink-muted)" stroke-width="1" stroke-dasharray="2 2" aria-hidden="true" />
  <text x="404" y="264" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">server finishes at t=1.8s, stores the</text>
  <text x="404" y="276" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">result keyed by abc123</text>

  <line x1="482" y1="200" x2="482" y2="232" stroke="var(--hairline)" stroke-width="1" aria-hidden="true" />
  <text x="482" y="196" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">t=2.0 client gives up</text>

  <rect x="532" y="208" width="80" height="24" rx="2" fill="var(--paper-raise)" stroke="var(--ch1)" stroke-width="1.3" />
  <text x="572" y="224" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ch1)">retry, same key</text>

  <text x="612" y="200" text-anchor="start" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">t=2.3</text>

  <rect x="576" y="250" width="106" height="26" rx="3" fill="var(--paper)" stroke="var(--ch1)" stroke-width="1.3" />
  <text x="629" y="267" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--ch1)">1 charge</text>

  <path d="M 612 232 C 612 244, 630 244, 629 248" fill="none" stroke="var(--ch1)" stroke-width="1.1" aria-hidden="true" />
  <text x="655" y="244" text-anchor="start" font-family="var(--font-mono)" font-size="8.5" fill="var(--ink-muted)">cached reply, instant</text>
</svg>
