---
/**
 * DecisionTreeJourney — a tiny support-ticket tree with the row path and leaf
 * probability made explicit.
 */
---

<svg
  class="diagram-svg"
  viewBox="0 0 780 390"
  role="img"
  aria-label="A decision tree classifies support tickets. The root asks whether failed sign-in attempts are at least three. No goes to a low-risk leaf with one urgent ticket out of ten. Yes asks whether the account is less than seven days old. No goes to a medium-risk leaf with three urgent tickets out of eight. Yes goes to a high-risk leaf with eight urgent tickets out of ten. A highlighted example with four failed attempts and a two-day-old account follows yes then yes to the high-risk leaf, which predicts urgency probability eight tenths. Leaves estimate from training rows and do not prove future probability."
>
  <defs>
    <marker id="tree-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L8,4 L0,8 Z" fill="var(--blueprint)" />
    </marker>
  </defs>

  <rect x="270" y="24" width="240" height="67" rx="11" fill="var(--highlight)" stroke="var(--ink)" stroke-width="2.5" />
  <text x="390" y="52" text-anchor="middle" font-family="var(--font-hand)" font-size="21" fill="var(--ink)">failed attempts ≥ 3?</text>
  <text x="390" y="74" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">root split</text>

  <path d="M326 91 C270 122 205 135 161 165" fill="none" stroke="var(--blueprint)" stroke-width="2.5" marker-end="url(#tree-arrow)" />
  <text x="237" y="127" font-family="var(--font-hand)" font-size="18" fill="var(--ink)">no</text>
  <path d="M454 91 C504 122 537 135 568 160" fill="none" stroke="var(--ch1)" stroke-width="4" marker-end="url(#tree-arrow)" />
  <text x="509" y="126" font-family="var(--font-hand)" font-size="18" fill="var(--ch1)">yes · example</text>

  <rect x="54" y="174" width="210" height="78" rx="11" fill="var(--paper-raise)" stroke="var(--ch1)" stroke-width="3" />
  <text x="159" y="201" text-anchor="middle" font-family="var(--font-hand)" font-size="21" fill="var(--ink)">low-risk leaf</text>
  <text x="159" y="224" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ink-muted)">1 urgent / 10 rows</text>
  <text x="159" y="240" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ch1)">p = 0.10</text>

  <rect x="480" y="166" width="235" height="67" rx="11" fill="var(--paper-raise)" stroke="var(--ink)" stroke-width="2.5" />
  <text x="598" y="194" text-anchor="middle" font-family="var(--font-hand)" font-size="21" fill="var(--ink)">account age &lt; 7 days?</text>
  <text x="598" y="216" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">second split</text>

  <path d="M550 233 C506 266 457 275 422 300" fill="none" stroke="var(--blueprint)" stroke-width="2.5" marker-end="url(#tree-arrow)" />
  <text x="493" y="271" font-family="var(--font-hand)" font-size="18" fill="var(--ink)">no</text>
  <path d="M646 233 C680 261 684 278 679 301" fill="none" stroke="var(--ch1)" stroke-width="4" marker-end="url(#tree-arrow)" />
  <text x="682" y="271" font-family="var(--font-hand)" font-size="18" fill="var(--ch1)">yes</text>

  <rect x="316" y="309" width="206" height="66" rx="11" fill="var(--paper-raise)" stroke="var(--ch2)" stroke-width="3" />
  <text x="419" y="335" text-anchor="middle" font-family="var(--font-hand)" font-size="20" fill="var(--ink)">medium-risk leaf</text>
  <text x="419" y="356" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ink-muted)">3 / 8 urgent · p=0.375</text>

  <rect x="569" y="309" width="190" height="66" rx="11" fill="var(--highlight)" stroke="var(--alert)" stroke-width="3" />
  <text x="664" y="335" text-anchor="middle" font-family="var(--font-hand)" font-size="20" fill="var(--ink)">high-risk leaf</text>
  <text x="664" y="356" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--alert)">8 / 10 urgent · p=0.80</text>

  <rect x="24" y="291" width="230" height="75" rx="9" fill="var(--paper)" stroke="var(--blueprint)" stroke-width="2" stroke-dasharray="6 4" />
  <text x="139" y="316" text-anchor="middle" font-family="var(--font-hand)" font-size="18" fill="var(--blueprint)">example ticket</text>
  <text x="139" y="338" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ink)">attempts=4 · age=2 days</text>
  <text x="139" y="354" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ch1)">yes → yes → p=0.80</text>
</svg>
