---
/**
 * GradientDescentLandscape — derivative/gradient as local slope and gradient
 * descent as repeated movement in the opposite direction.
 */
---

<svg
  class="diagram-svg"
  viewBox="0 0 760 350"
  role="img"
  aria-label="A bowl-shaped loss curve has high loss at both sides and minimum loss in the centre. A parameter starts on the left slope. The derivative there is negative, so subtracting the derivative moves the parameter right. Four progressively smaller steps move downhill towards the minimum. A tangent line at the starting point shows that a derivative is local slope, not a description of the whole curve."
>
  <defs>
    <marker id="gradient-arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto">
      <path d="M0,0 L9,4.5 L0,9 Z" fill="var(--blueprint)" />
    </marker>
  </defs>

  <line x1="76" y1="298" x2="710" y2="298" stroke="var(--ink-muted)" stroke-width="1.5" />
  <line x1="76" y1="298" x2="76" y2="32" stroke="var(--ink-muted)" stroke-width="1.5" />
  <text x="706" y="324" text-anchor="end" font-family="var(--font-hand)" font-size="18" fill="var(--ink-muted)">parameter w →</text>
  <text x="46" y="50" text-anchor="middle" font-family="var(--font-hand)" font-size="18" fill="var(--ink-muted)">loss</text>

  <path d="M112 62 C190 95 230 250 376 279 C522 250 565 95 648 62" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round" />
  <text x="376" y="311" text-anchor="middle" font-family="var(--font-hand)" font-size="19" fill="var(--ch1)">minimum</text>

  <line x1="110" y1="128" x2="270" y2="210" stroke="var(--ch2)" stroke-width="3" stroke-dasharray="7 4" />
  <text x="122" y="112" font-family="var(--font-hand)" font-size="18" fill="var(--ch2)">tangent = local slope</text>

  <circle cx="164" cy="157" r="9" fill="var(--ch2)" stroke="var(--ink)" stroke-width="2" />
  <text x="150" y="143" text-anchor="end" font-family="var(--font-mono)" font-size="10" fill="var(--ink)">start</text>
  <circle cx="252" cy="232" r="8" fill="var(--highlight)" stroke="var(--ink)" stroke-width="2" />
  <circle cx="316" cy="267" r="7" fill="var(--highlight)" stroke="var(--ink)" stroke-width="2" />
  <circle cx="355" cy="277" r="6" fill="var(--highlight)" stroke="var(--ink)" stroke-width="2" />
  <circle cx="376" cy="279" r="6" fill="var(--ch1)" stroke="var(--ink)" stroke-width="2" />

  <path d="M177 164 C198 181 221 210 243 225" fill="none" stroke="var(--blueprint)" stroke-width="4" marker-end="url(#gradient-arrow)" />
  <path d="M263 237 C279 249 295 259 307 264" fill="none" stroke="var(--blueprint)" stroke-width="4" marker-end="url(#gradient-arrow)" />
  <path d="M327 269 C337 273 344 275 348 276" fill="none" stroke="var(--blueprint)" stroke-width="4" marker-end="url(#gradient-arrow)" />
  <path d="M363 278 H369" fill="none" stroke="var(--blueprint)" stroke-width="4" marker-end="url(#gradient-arrow)" />

  <rect x="484" y="190" width="218" height="86" rx="9" fill="var(--paper-raise)" stroke="var(--blueprint)" stroke-width="2" />
  <text x="593" y="219" text-anchor="middle" font-family="var(--font-hand)" font-size="20" fill="var(--blueprint)">update rule</text>
  <text x="593" y="244" text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="var(--ink)">w = w − learning_rate × gradient</text>
  <text x="593" y="263" text-anchor="middle" font-family="var(--font-hand)" font-size="16" fill="var(--ink-muted)">opposite the uphill direction</text>
</svg>
