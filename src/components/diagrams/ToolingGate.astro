---
/**
 * ToolingGate — the pipeline a change goes through before it's trusted. ruff
 * (format + lint) is cheapest and runs first, then mypy (types), then pytest
 * (behaviour, the slowest since it actually executes code). pre-commit runs
 * all three and only lets the commit through if every one passes; on any
 * failure it blocks the commit and sends you back to fix it.
 */
const stages = [
  { x: 150, label: 'ruff', sub: 'format + lint' },
  { x: 284, label: 'mypy', sub: 'types' },
  { x: 418, label: 'pytest', sub: 'behaviour' },
];
---

<svg
  class="diagram-svg"
  viewBox="0 0 720 260"
  role="img"
  aria-label="Your code passes through ruff, then mypy, then pytest, in that order — cheapest and fastest check first, slowest last. pre-commit runs all three; if every one passes, the commit proceeds. If any one fails, the commit is blocked and control returns to your code to fix and retry."
>
  <!-- your code -->
  <rect x="16" y="100" width="100" height="60" rx="3" fill="var(--paper)" stroke="var(--frame)" />
  <text x="66" y="126" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--ink)">YOUR</text>
  <text x="66" y="142" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--ink)">CODE</text>

  {
    stages.map((s) => (
      <g aria-hidden="true">
        <rect x={s.x} y="100" width="100" height="60" rx="3" fill="var(--paper-raise)" stroke="var(--blueprint)" stroke-width="1.2" />
        <text x={s.x + 50} y="126" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--blueprint)">{s.label}</text>
        <text x={s.x + 50} y="144" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">{s.sub}</text>
      </g>
    ))
  }

  <!-- arrows between stages -->
  <line x1="116" y1="130" x2="148" y2="130" stroke="var(--frame)" stroke-width="1.2" aria-hidden="true" />
  <polygon points="148,130 140,126 140,134" fill="var(--frame)" aria-hidden="true" />
  <line x1="250" y1="130" x2="282" y2="130" stroke="var(--frame)" stroke-width="1.2" aria-hidden="true" />
  <polygon points="282,130 274,126 274,134" fill="var(--frame)" aria-hidden="true" />
  <line x1="384" y1="130" x2="416" y2="130" stroke="var(--frame)" stroke-width="1.2" aria-hidden="true" />
  <polygon points="416,130 408,126 408,134" fill="var(--frame)" aria-hidden="true" />

  <!-- pre-commit gate (diamond) -->
  <polygon points="590,90 636,130 590,170 544,130" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.3" />
  <text x="590" y="126" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ink)">pre-commit</text>
  <text x="590" y="140" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ink)">all pass?</text>

  <line x1="518" y1="130" x2="542" y2="130" stroke="var(--frame)" stroke-width="1.2" aria-hidden="true" />
  <polygon points="542,130 534,126 534,134" fill="var(--frame)" aria-hidden="true" />

  <!-- pass -> commit -->
  <rect x="656" y="106" width="56" height="48" rx="3" fill="var(--paper)" stroke="var(--ch1)" stroke-width="1.3" />
  <text x="684" y="126" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ch1)">commit</text>
  <text x="684" y="140" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ch1)">✓</text>
  <line x1="636" y1="130" x2="654" y2="130" stroke="var(--ch1)" stroke-width="1.3" aria-hidden="true" />
  <polygon points="654,130 646,126 646,134" fill="var(--ch1)" aria-hidden="true" />
  <text x="645" y="112" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ch1)">yes</text>

  <!-- fail -> blocked, loop back -->
  <path d="M 570 168 C 500 230, 200 230, 90 162" fill="none" stroke="var(--ch2)" stroke-width="1.2" stroke-dasharray="4 3" aria-hidden="true" />
  <polygon points="90,162 96,172 102,161" fill="var(--ch2)" aria-hidden="true" />
  <text x="330" y="226" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ch2)">no → commit blocked, fix and retry</text>
</svg>
