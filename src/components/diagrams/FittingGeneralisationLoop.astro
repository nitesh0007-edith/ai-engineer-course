---
/**
 * FittingGeneralisationLoop — parameters change only from training feedback,
 * validation guides choices, and test remains sealed until the end.
 */
---

<svg
  class="diagram-svg"
  viewBox="0 0 780 365"
  role="img"
  aria-label="Training examples enter a model with adjustable parameters. Predictions are compared with training targets by a loss function. An optimiser uses the loss gradient to update parameters, forming a repeated fitting loop. A separate validation set compares candidate choices without updating model parameters. After choices are frozen, a sealed test set is used once to estimate generalisation to unseen data. Deployment monitoring feeds new evidence into a future retraining process, not directly into the completed test result."
>
  <defs>
    <marker id="fit-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L8,4 L0,8 Z" fill="var(--blueprint)" />
    </marker>
    <marker id="fit-green-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L8,4 L0,8 Z" fill="var(--ch1)" />
    </marker>
  </defs>

  <text x="212" y="31" text-anchor="middle" font-family="var(--font-hand)" font-size="20" fill="var(--ch1)">training loop · parameters change here</text>
  <rect x="15" y="47" width="535" height="235" rx="14" fill="none" stroke="var(--ch1)" stroke-width="2.5" stroke-dasharray="8 5" />

  <rect x="36" y="98" width="112" height="64" rx="9" fill="var(--paper-raise)" stroke="var(--ink)" stroke-width="2" />
  <text x="92" y="124" text-anchor="middle" font-family="var(--font-hand)" font-size="19" fill="var(--ink)">training batch</text>
  <text x="92" y="146" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">features + target</text>
  <path d="M148 130 H185" stroke="var(--blueprint)" stroke-width="3" marker-end="url(#fit-arrow)" />

  <rect x="197" y="91" width="126" height="78" rx="9" fill="var(--highlight)" stroke="var(--blueprint)" stroke-width="3" />
  <text x="260" y="119" text-anchor="middle" font-family="var(--font-hand)" font-size="22" fill="var(--ink)">model</text>
  <text x="260" y="142" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ink-muted)">parameters θ</text>
  <path d="M323 130 H360" stroke="var(--blueprint)" stroke-width="3" marker-end="url(#fit-arrow)" />

  <rect x="372" y="98" width="82" height="64" rx="9" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
  <text x="413" y="124" text-anchor="middle" font-family="var(--font-hand)" font-size="18" fill="var(--ink)">prediction</text>
  <text x="413" y="146" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">ŷ</text>
  <path d="M454 130 H483" stroke="var(--blueprint)" stroke-width="3" marker-end="url(#fit-arrow)" />

  <rect x="492" y="98" width="42" height="64" rx="9" fill="var(--paper-raise)" stroke="var(--alert)" stroke-width="2" />
  <text x="513" y="124" text-anchor="middle" font-family="var(--font-hand)" font-size="18" fill="var(--ink)">loss</text>
  <text x="513" y="145" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--alert)">error</text>

  <path d="M513 162 V216 H398" fill="none" stroke="var(--blueprint)" stroke-width="2.5" marker-end="url(#fit-arrow)" />
  <rect x="264" y="196" width="122" height="55" rx="9" fill="var(--paper-raise)" stroke="var(--ch2)" stroke-width="2" />
  <text x="325" y="220" text-anchor="middle" font-family="var(--font-hand)" font-size="18" fill="var(--ink)">optimiser</text>
  <text x="325" y="239" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">update θ</text>
  <path d="M264 223 C213 223 210 186 238 172" fill="none" stroke="var(--ch1)" stroke-width="3" marker-end="url(#fit-green-arrow)" />

  <rect x="580" y="49" width="178" height="66" rx="9" fill="var(--paper-raise)" stroke="var(--ch2)" stroke-width="3" />
  <text x="669" y="76" text-anchor="middle" font-family="var(--font-hand)" font-size="20" fill="var(--ink)">validation set</text>
  <text x="669" y="97" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">choose settings · no fitting</text>

  <path d="M669 115 V150" stroke="var(--blueprint)" stroke-width="2.5" marker-end="url(#fit-arrow)" />
  <rect x="580" y="161" width="178" height="66" rx="9" fill="var(--paper-raise)" stroke="var(--blueprint)" stroke-width="3" />
  <text x="669" y="188" text-anchor="middle" font-family="var(--font-hand)" font-size="20" fill="var(--ink)">sealed test set</text>
  <text x="669" y="209" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">final unseen estimate once</text>

  <path d="M669 227 V264" stroke="var(--blueprint)" stroke-width="2.5" marker-end="url(#fit-arrow)" />
  <rect x="580" y="275" width="178" height="66" rx="9" fill="var(--highlight)" stroke="var(--ink)" stroke-width="2" />
  <text x="669" y="302" text-anchor="middle" font-family="var(--font-hand)" font-size="20" fill="var(--ink)">deployment</text>
  <text x="669" y="323" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">monitor future evidence</text>

  <path d="M580 308 C516 351 361 347 325 266" fill="none" stroke="var(--blueprint)" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#fit-arrow)" />
  <text x="434" y="343" text-anchor="middle" font-family="var(--font-hand)" font-size="16" fill="var(--blueprint)">new version · fresh split · retrain</text>

  <text x="18" y="314" font-family="var(--font-hand)" font-size="17" fill="var(--alert)">generalisation question:</text>
  <text x="18" y="337" font-family="var(--font-mono)" font-size="10" fill="var(--ink)">will the learned pattern work on relevant unseen cases?</text>
</svg>
