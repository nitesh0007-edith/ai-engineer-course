---
/**
 * RequestContract — the shape every FastAPI + Pydantic endpoint enforces.
 * The request body is checked against a Pydantic model before your handler
 * ever runs; a mismatch never reaches your code at all, it short-circuits
 * straight to a 422 with a field-level error. Only a request that matches
 * the contract reaches the handler, whose return value is checked against
 * the response model on the way back out.
 */
---

<svg
  class="diagram-svg"
  viewBox="0 0 720 320"
  role="img"
  aria-label="A client's JSON request first passes through a Pydantic request model. If a field is missing or the wrong type, the request never reaches the handler — it is rejected immediately with a 422 response and a field-level error message. Only a request that matches the schema reaches the handler function, whose return value is then checked against a Pydantic response model before being sent back to the client as JSON."
>
  <!-- client -->
  <rect x="16" y="120" width="96" height="60" rx="3" fill="var(--paper)" stroke="var(--frame)" />
  <text x="64" y="146" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--ink)">CLIENT</text>
  <text x="64" y="162" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">sends JSON</text>

  <line x1="112" y1="150" x2="146" y2="150" stroke="var(--frame)" stroke-width="1.2" aria-hidden="true" />
  <polygon points="146,150 138,146 138,154" fill="var(--frame)" aria-hidden="true" />

  <!-- request model -->
  <rect x="150" y="120" width="120" height="60" rx="3" fill="var(--paper-raise)" stroke="var(--blueprint)" stroke-width="1.2" />
  <text x="210" y="144" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--blueprint)">Pydantic</text>
  <text x="210" y="158" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--blueprint)">request model</text>
  <text x="210" y="172" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">fields + types</text>

  <line x1="270" y1="150" x2="300" y2="150" stroke="var(--frame)" stroke-width="1.2" aria-hidden="true" />
  <polygon points="300,150 292,146 292,154" fill="var(--frame)" aria-hidden="true" />

  <!-- valid? diamond -->
  <polygon points="356,110 402,150 356,190 310,150" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.3" />
  <text x="356" y="146" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ink)">matches</text>
  <text x="356" y="160" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ink)">schema?</text>

  <!-- yes -> handler -->
  <line x1="402" y1="150" x2="432" y2="150" stroke="var(--ch1)" stroke-width="1.3" aria-hidden="true" />
  <polygon points="432,150 424,146 424,154" fill="var(--ch1)" aria-hidden="true" />
  <text x="417" y="136" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ch1)">yes</text>

  <rect x="436" y="120" width="106" height="60" rx="3" fill="var(--paper-raise)" stroke="var(--ch1)" stroke-width="1.2" />
  <text x="489" y="146" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--ch1)">handler</text>
  <text x="489" y="160" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">your function</text>

  <line x1="542" y1="150" x2="572" y2="150" stroke="var(--ch1)" stroke-width="1.2" aria-hidden="true" />
  <polygon points="572,150 564,146 564,154" fill="var(--ch1)" aria-hidden="true" />

  <!-- response model -->
  <rect x="576" y="120" width="128" height="60" rx="3" fill="var(--paper-raise)" stroke="var(--blueprint)" stroke-width="1.2" />
  <text x="640" y="144" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--blueprint)">Pydantic</text>
  <text x="640" y="158" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--blueprint)">response model</text>
  <text x="640" y="172" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">200 + JSON</text>

  <path d="M 640 120 C 640 40, 64 40, 64 118" fill="none" stroke="var(--ch1)" stroke-width="1.1" stroke-dasharray="3 3" aria-hidden="true" />
  <polygon points="64,118 58,128 70,128" fill="var(--ch1)" aria-hidden="true" />
  <text x="352" y="34" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--ch1)">back to the client, as validated JSON</text>

  <!-- no -> 422 -->
  <line x1="356" y1="190" x2="356" y2="236" stroke="var(--ch2)" stroke-width="1.3" aria-hidden="true" />
  <polygon points="356,236 352,228 360,228" fill="var(--ch2)" aria-hidden="true" />
  <text x="374" y="216" text-anchor="start" font-family="var(--font-mono)" font-size="9" fill="var(--ch2)">no</text>

  <rect x="256" y="240" width="200" height="56" rx="3" fill="var(--paper)" stroke="var(--ch2)" stroke-width="1.3" />
  <text x="356" y="262" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--ch2)">422 Unprocessable Entity</text>
  <text x="356" y="278" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">field-level error, handler never runs</text>

  <path d="M 256 268 C 180 268, 100 220, 68 182" fill="none" stroke="var(--ch2)" stroke-width="1.1" stroke-dasharray="3 3" aria-hidden="true" />
  <polygon points="68,182 66,192 78,188" fill="var(--ch2)" aria-hidden="true" />
</svg>
