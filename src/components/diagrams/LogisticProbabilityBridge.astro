---
/**
 * LogisticProbabilityBridge — linear score to log-odds to probability and a
 * thresholded decision boundary.
 */
---

<svg
  class="diagram-svg"
  viewBox="0 0 780 390"
  role="img"
  aria-label="A feature vector enters a weighted sum called a logit. The logit can take any real value and represents log odds. A sigmoid S-shaped curve converts it into a probability between zero and one. A chosen threshold, shown at probability 0.5 for illustration, converts probability into a class decision. At 0.5 the corresponding logit is zero and odds are one to one. Moving the threshold changes false positives and false negatives without refitting model parameters."
>
  <defs>
    <marker id="logit-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
      <path d="M0,0 L8,4 L0,8 Z" fill="var(--blueprint)" />
    </marker>
  </defs>

  <rect x="17" y="45" width="138" height="78" rx="10" fill="var(--paper-raise)" stroke="var(--ink)" stroke-width="2" />
  <text x="86" y="75" text-anchor="middle" font-family="var(--font-hand)" font-size="21" fill="var(--ink)">features x</text>
  <text x="86" y="97" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">length · account age</text>
  <path d="M155 84 H199" stroke="var(--blueprint)" stroke-width="3" marker-end="url(#logit-arrow)" />

  <rect x="211" y="45" width="160" height="78" rx="10" fill="var(--highlight)" stroke="var(--blueprint)" stroke-width="3" />
  <text x="291" y="73" text-anchor="middle" font-family="var(--font-hand)" font-size="21" fill="var(--ink)">linear score · logit</text>
  <text x="291" y="96" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--ink)">z = w·x + b</text>
  <text x="291" y="112" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">−∞ to +∞</text>
  <path d="M371 84 H415" stroke="var(--blueprint)" stroke-width="3" marker-end="url(#logit-arrow)" />

  <rect x="427" y="45" width="142" height="78" rx="10" fill="var(--paper-raise)" stroke="var(--ch2)" stroke-width="3" />
  <text x="498" y="72" text-anchor="middle" font-family="var(--font-hand)" font-size="21" fill="var(--ink)">sigmoid</text>
  <text x="498" y="96" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--ink)">1 / (1 + e⁻ᶻ)</text>
  <text x="498" y="112" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">0 to 1</text>
  <path d="M569 84 H613" stroke="var(--blueprint)" stroke-width="3" marker-end="url(#logit-arrow)" />

  <rect x="625" y="45" width="138" height="78" rx="10" fill="var(--paper-raise)" stroke="var(--ink)" stroke-width="2" />
  <text x="694" y="74" text-anchor="middle" font-family="var(--font-hand)" font-size="21" fill="var(--ink)">probability p</text>
  <text x="694" y="98" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">then apply threshold</text>

  <line x1="88" y1="331" x2="699" y2="331" stroke="var(--ink)" stroke-width="2" />
  <line x1="390" y1="348" x2="390" y2="157" stroke="var(--ink)" stroke-width="2" />
  <text x="699" y="355" text-anchor="end" font-family="var(--font-hand)" font-size="17" fill="var(--ink)">logit z</text>
  <text x="366" y="166" text-anchor="end" font-family="var(--font-hand)" font-size="17" fill="var(--ink)">p</text>

  <line x1="99" y1="239" x2="682" y2="239" stroke="var(--frame)" stroke-width="1.5" stroke-dasharray="6 4" />
  <text x="83" y="244" text-anchor="end" font-family="var(--font-mono)" font-size="10" fill="var(--ink-muted)">0.5</text>
  <path d="M110 322 C250 319 306 292 350 258 C373 241 383 239 390 239 C407 239 417 234 432 221 C489 172 545 159 675 156" fill="none" stroke="var(--blueprint)" stroke-width="4" />
  <circle cx="390" cy="239" r="7" fill="var(--alert)" stroke="var(--paper)" stroke-width="2" />

  <line x1="390" y1="239" x2="390" y2="331" stroke="var(--alert)" stroke-width="2" stroke-dasharray="5 4" />
  <text x="390" y="375" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--alert)">z=0 · odds 1:1 · p=0.5</text>

  <rect x="104" y="176" width="170" height="47" rx="7" fill="var(--paper-raise)" stroke="var(--ch1)" />
  <text x="189" y="196" text-anchor="middle" font-family="var(--font-hand)" font-size="17" fill="var(--ink)">threshold is a policy choice</text>
  <text x="189" y="213" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--ink-muted)">not always 0.5</text>
</svg>
