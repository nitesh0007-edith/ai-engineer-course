---
import { marked } from 'marked';

/** Auto-rendered from frontmatter: <Exercises data={frontmatter} />. */
const { data } = Astro.props;
type Exercise = { prompt: string; difficulty: 'warmup' | 'core' | 'stretch'; solution: string };
const exercises: Exercise[] = data?.exercises ?? [];

// Solutions are authored Markdown (they often contain code blocks). Rendered
// here to HTML — the source is trusted chapter frontmatter, not user input.
const rendered = exercises.map((ex) => marked.parse(ex.solution) as string);
---

<div class="block exercises">
  {
    exercises.map((ex, i) => (
      <div class="exercise">
        <span class={`tag ${ex.difficulty}`}>
          {ex.difficulty} · {i + 1}
        </span>
        <p class="prompt">{ex.prompt}</p>
        <details>
          <summary>Reveal solution</summary>
          <div class="solution" set:html={rendered[i]} />
        </details>
      </div>
    ))
  }
</div>
