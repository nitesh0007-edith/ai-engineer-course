{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --port 4321",
      "startServerReadyPattern": "localhost",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4321/ai-engineer-course/",
        "http://localhost:4321/ai-engineer-course/chapters/how-to-use-this-course/",
        "http://localhost:4321/ai-engineer-course/chapters/python-for-ai-engineering/",
        "http://localhost:4321/ai-engineer-course/chapters/async-python/",
        "http://localhost:4321/ai-engineer-course/chapters/modern-python-tooling/",
        "http://localhost:4321/ai-engineer-course/chapters/apis-and-services/",
        "http://localhost:4321/ai-engineer-course/chapters/data-and-storage/",
        "http://localhost:4321/ai-engineer-course/chapters/containers-git-and-ci/",
        "http://localhost:4321/ai-engineer-course/chapters/maths-i-linear-algebra-calculus/",
        "http://localhost:4321/ai-engineer-course/chapters/maths-ii-probability-statistics-optimisation/",
        "http://localhost:4321/ai-engineer-course/chapters/data-foundations/",
        "http://localhost:4321/ai-engineer-course/chapters/what-learning-from-data-means/",
        "http://localhost:4321/ai-engineer-course/chapters/linear-and-logistic-regression/",
        "http://localhost:4321/ai-engineer-course/chapters/trees-and-ensembles/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
