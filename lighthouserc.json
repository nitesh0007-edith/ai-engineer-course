{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --port 4321",
      "startServerReadyPattern": "localhost",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/chapters/how-to-use-this-course/",
        "http://localhost:4321/chapters/python-for-ai-engineering/",
        "http://localhost:4321/chapters/async-python/",
        "http://localhost:4321/chapters/modern-python-tooling/",
        "http://localhost:4321/chapters/apis-and-services/",
        "http://localhost:4321/chapters/data-and-storage/",
        "http://localhost:4321/chapters/containers-git-and-ci/",
        "http://localhost:4321/chapters/maths-i-linear-algebra-calculus/",
        "http://localhost:4321/chapters/maths-ii-probability-statistics-optimisation/",
        "http://localhost:4321/chapters/data-foundations/",
        "http://localhost:4321/chapters/what-learning-from-data-means/",
        "http://localhost:4321/chapters/linear-and-logistic-regression/",
        "http://localhost:4321/chapters/trees-and-ensembles/",
        "http://localhost:4321/chapters/other-core-algorithms/",
        "http://localhost:4321/chapters/unsupervised-learning/",
        "http://localhost:4321/chapters/evaluation-done-properly/",
        "http://localhost:4321/chapters/bias-variance-and-regularisation/",
        "http://localhost:4321/chapters/pipelines-interpretability-and-adjacent-problems/",
        "http://localhost:4321/chapters/from-neurons-to-networks/",
        "http://localhost:4321/chapters/backpropagation-from-scratch/",
        "http://localhost:4321/chapters/pytorch/",
        "http://localhost:4321/chapters/training-mechanics/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
